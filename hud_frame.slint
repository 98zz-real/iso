// hud_frame.slint — der Rahmen, lose inspiriert vom Referenzbild:
// abgeschrägte Ecken-Klammern + gepunktete Leisten oben/unten, im Neon-Look.
// Bewusst als eigenständiges, eigenes Design umgesetzt (kein Nachbau des
// Originalbilds), Mitte bleibt komplett leer für eigenen Content.
//
// Jede Ecke wird als eigener, fest definierter Pfad gezeichnet (keine
// rotation-angle-Tricks -> vermeidet Kompatibilitätsprobleme zwischen
// Slint-Versionen).

import { Theme } from "theme.slint";

component TopLeftBracket inherits Path {
    width: Theme.corner-size;
    height: Theme.corner-size;
    stroke: Theme.accent;
    stroke-width: Theme.border-thickness;
    fill: transparent;
    viewbox-width: 100;
    viewbox-height: 100;

    MoveTo { x: 0; y: 100; }
    LineTo { x: 0; y: 20; }
    LineTo { x: 20; y: 0; }
    LineTo { x: 100; y: 0; }
}

component TopRightBracket inherits Path {
    width: Theme.corner-size;
    height: Theme.corner-size;
    stroke: Theme.accent;
    stroke-width: Theme.border-thickness;
    fill: transparent;
    viewbox-width: 100;
    viewbox-height: 100;

    MoveTo { x: 0; y: 0; }
    LineTo { x: 80; y: 0; }
    LineTo { x: 100; y: 20; }
    LineTo { x: 100; y: 100; }
}

component BottomRightBracket inherits Path {
    width: Theme.corner-size;
    height: Theme.corner-size;
    stroke: Theme.accent;
    stroke-width: Theme.border-thickness;
    fill: transparent;
    viewbox-width: 100;
    viewbox-height: 100;

    MoveTo { x: 100; y: 0; }
    LineTo { x: 100; y: 80; }
    LineTo { x: 80; y: 100; }
    LineTo { x: 0; y: 100; }
}

component BottomLeftBracket inherits Path {
    width: Theme.corner-size;
    height: Theme.corner-size;
    stroke: Theme.accent;
    stroke-width: Theme.border-thickness;
    fill: transparent;
    viewbox-width: 100;
    viewbox-height: 100;

    MoveTo { x: 100; y: 100; }
    LineTo { x: 20; y: 100; }
    LineTo { x: 0; y: 80; }
    LineTo { x: 0; y: 0; }
}

// Eine Reihe kleiner Neon-Punkte, wie die LED-Leisten oben/unten im Referenzbild.
component DotRow inherits Rectangle {
    in property <int> dot-count: 24;
    height: 6px;

    HorizontalLayout {
        spacing: (parent.width - dot-count * 6px) / (dot-count - 1);
        for i in dot-count: Rectangle {
            width: 6px;
            height: 6px;
            border-radius: 3px;
            background: Theme.accent;
            opacity: 0.35 + 0.65 * Math.abs(Math.sin(i * 0.7rad));
        }
    }
}

export component HudFrame inherits Rectangle {
    background: Theme.bg-color;

    // vier Ecken-Klammern, jeweils als eigener Pfad (kein Rotieren nötig)
    TopLeftBracket {
        x: 8px; y: 8px;
    }
    TopRightBracket {
        x: parent.width - self.width - 8px; y: 8px;
    }
    BottomRightBracket {
        x: parent.width - self.width - 8px; y: parent.height - self.height - 8px;
    }
    BottomLeftBracket {
        x: 8px; y: parent.height - self.height - 8px;
    }

    // Punktreihen oben und unten, zwischen den Ecken
    DotRow {
        x: Theme.corner-size + 24px;
        y: 14px;
        width: parent.width - 2 * (Theme.corner-size + 24px);
    }
    DotRow {
        x: Theme.corner-size + 24px;
        y: parent.height - 14px - 6px;
        width: parent.width - 2 * (Theme.corner-size + 24px);
    }

    // Rahmenlinie (dünn, gedimmt) zwischen den Ecken-Klammern
    Rectangle {
        x: 8px; y: 8px;
        width: parent.width - 16px;
        height: parent.height - 16px;
        border-width: 1px;
        border-color: Theme.accent-dim;
        background: transparent;
    }

    // Der eigentliche Inhaltsbereich — hier kommt alles Freie rein
    content-area := Rectangle {
        x: Theme.corner-size + 32px;
        y: Theme.corner-size + 8px;
        width: parent.width - 2 * (Theme.corner-size + 32px);
        height: parent.height - 2 * (Theme.corner-size + 8px);

        @children
    }
}
